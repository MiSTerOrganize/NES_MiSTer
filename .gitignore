# Quartus working folders and large per-compile reports (regenerated every compile)
fpga/db/
fpga/incremental_db/
fpga/greybox_tmp/
fpga/simulation/
fpga/hc_output/
fpga/hps_isw_handoff/
fpga/output_files/*
# KEEP the timing / fit / map summaries of the shipped build (tiny, used by audits)
!fpga/output_files/*.summary
fpga/build_id.v
fpga/c5_pin_model_dump.txt
fpga/PLLJ_PLLSPE_INFO.txt
fpga/*.qws
fpga/*.qdf
fpga/jtag.cdf
fpga/.qsys_edit/

# ARM daemon build output (CI commits the shipped binary to games/NES_HD/NES_HD)
build-arm/
*.o
*.a

# Python / tool scratch
__pycache__/
*.pyc
tools/audio/oggdecode.exe

*.bak
*.orig
*.rej
